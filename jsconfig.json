{
  "compilerOptions": {
    "baseUrl": "./frontend",
    "paths": {
      "*": ["./node_modules/*", "./src/*", "./*"]
    },
    "jsx": "react-native",
    "moduleResolution": "node",
    "target": "es2020",
    "allowSyntheticDefaultImports": true
  },
  "exclude": [
    "**/node_modules/*",
    "backend"
  ]
}
