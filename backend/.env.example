# RoomMates Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roommates?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_roommates_2026
JWT_EXPIRES_IN=30d

# Client URL (for CORS and Socket.io)
CLIENT_URL=*
